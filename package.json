{
  "name": "task-hub",
  "version": "1.2.3",
  "private": true,
  "license": "MIT",
  "description": "One task, many agent sessions, one shared progress folder.",
  "openchamber": {
    "apiVersion": 1,
    "engines": {
      "openchamber": ">=1.24.0"
    },
    "contributes": {
      "panel": {
        "id": "task-hub",
        "name": "Task Hub",
        "icon": "links",
        "entry": "panel/index.html"
      },
      "capabilities": [
        "sessions"
      ],
      "filesystem": [
        "~/.task-hub/**"
      ]
    }
  }
}
