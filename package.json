{
  "name": "task-hub",
  "version": "1.9.0",
  "private": true,
  "license": "MIT",
  "description": "One task, many agent sessions, one shared progress folder.",
  "bin": {
    "taskhub": "bin/taskhub.mjs"
  },
  "scripts": {
    "build:panel": "esbuild panel/src.js --bundle --format=iife --platform=browser --outfile=panel/main.js",
    "integrations:install": "node scripts/install-integrations.mjs",
    "integrations:dry": "node scripts/install-integrations.mjs --dry-run"
  },
  "openchamber": {
    "apiVersion": 1,
    "engines": {
      "openchamber": ">=1.24.0"
    },
    "contributes": {
      "panel": {
        "id": "task-hub",
        "name": "Task Hub",
        "icon": "links",
        "entry": "panel/index.html"
      },
      "page": {
        "entry": "panel/index.html",
        "title": "Task Hub"
      },
      "capabilities": [
        "sessions",
        "prompt"
      ],
      "filesystem": [
        "~/.task-hub/**"
      ],
      "service": {
        "entry": "service/main.js",
        "runtime": "host",
        "permissions": {
          "exec": [
            "opencode"
          ]
        }
      }
    }
  }
}
